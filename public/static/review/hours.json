 "photo_reference" : "Aap_uEDx6XzkEoQk4lP-rnpYk4j8mQWInnxe1jEWGWHcVw9qjKs3C5uI3SIAKKLL0I7B_H_wZ14bQM3sJXv0vDhNdxHK7cny79gGy48ewTFh-99c5nC3FoLcHlFvDuCm--Y4-Cp86q8_XY4S-_zInxs_FEwPjB32YLHKn9lCMK9ame6_xNz_", "width" : 2560 } ], "place_id" : "ChIJb_5Gzq9u1moRTJZzrye5XpU", "plus_code" : { "compound_code" : "4253+H4 Elsternwick VIC, Australia", "global_code" : "4RJ74253+H4" }, "rating" : 4, "reference" : "ChIJb_5Gzq9u1moRTJZzrye5XpU", "reviews" : [ { "author_name" : "Shalika Karunanayake", "author_url" : "https://www.google.com/maps/contrib/100450310542902413141/reviews", "language" : "en", "profile_photo_url" : "https://lh3.googleusercontent.com/a-/AOh14GhMCRQ4kwIBMj1w8zkCy0Ya1qXCHsoDVxsNe0nq=s128-c0x00000000-cc-rp-mo", "rating" : 5, "relative_time_description" : "in the last week", "text" : "I recently deposited for a car and due to unexpected personal circumstances, I could not go ahead with the purchase. However, Dene Gregg has been absolutely helpful and understanding through out. From day one he has been very attentive to my needs and I found him not only friendly but very reliable. Thanks for refunding the deposit in timely manner. The whole experience was great. I would highly recommend Dene to anyone who is looking to buy a car.", "time" : 1626251920 }, { "author_name" : "Susan Martin", "author_url" : "https://www.google.com/maps/contrib/109465945841056984927/reviews", "language" : "en", "profile_photo_url" : "https://lh3.googleusercontent.com/a/AATXAJxuHuapdqqXJ9P5iWIUmcriuM2r0WRZAZ9SFle4=s128-c0x00000000-cc-rp-mo", "rating" : 5, "relative_time_description" : "3 weeks ago", "text" : "Dene Gregg is awesome to deal with. He provided for a hassle free and smooth purchase of a Holden Astra in Melbourne. The car is awesome too! Big thanks to Dene for his professional manner and great service..", "time" : 1624413039 }, { "author_name" : "Rebekah Black", "author_url" : "https://www.google.com/maps/contrib/110969555727416094032/reviews", "language" : "en", "profile_photo_url" : "https://lh3.googleusercontent.com/a-/AOh14GhMZBhcbVxHuGOg7Hv5qm6m3cCRSHpXviSuxkig=s128-c0x00000000-cc-rp-mo", "rating" : 5, "relative_time_description" : "a week ago", "text" : "I purchased a Pajero from Dene Gregg. The car was presented so well and the transaction was seamless. I would also recommend Rob for a wonderful easy process in getting finance. I had to do everything over the phone as I am in country Victoria, both Dene and Rob helped and made sure that everything was ready when I came down to Melbourne. Very happy customer. Thank you", "time" : 1625615393 }, { "author_name" : "Joel Arthur", "author_url" : "https://www.google.com/maps/contrib/116382147452512738239/reviews", "language" : "en", "profile_photo_url" : "https://lh3.googleusercontent.com/a-/AOh14GhC8nnL-MmH-ZdCaz9TFYh4bmFFZtueISL6OUAEzwc=s128-c0x00000000-cc-rp-mo", "rating" : 5, "relative_time_description" : "3 months ago", "text" : "Had the pleasure of purchasing a near new Holden Arcadia from Brighten Mitsubishi. I spent significant time researching models etc making sure I found the right one in the best possible condition. After I contacted Dean from Brighton Mitsubishi, he assured me they had the largest allocation of Acadia’s and I would find a car that suits.\n\nUpon arrival, I was pleasantly surprised just how many cars were available for sale, particularly when there were at least six Arcadia’s for sale . I was fortunate enough to find a low km plumb example , almost as new condition. Had the car now for 24hrs & I can say I absolutely love it. Ticks all boxes , just what in wanted.\n\nDean was very friendly & most importantly, helpful. He’s also got a great sense of humour , loves a chat. Also, his open & no nonsense approach is refreshing . He looked after me with the price & also provided me with some new floor mats .\n\nThe vehicle on pick up had been cleaned both inside and out & looked like it just came off the factory floor. There was a couple of marks in the boot , which Dean promised to fix, which he did.\n\nAll up, an unexpected very pleasant car buying experience .", "time" : 1617166686 }, { "author_name" : "Natalie Karlovic", "author_url" : "https://www.google.com/maps/contrib/105866892328758156391/reviews", "language" : "en", "profile_photo_url" : "https://lh3.googleusercontent.com/a/AATXAJx1Fgmz0f9pjyrkVPTm-ED_UV1xykew1edeGLIe=s128-c0x00000000-cc-rp-mo", "rating" : 5, "relative_time_description" : "a month ago", "text" : "My partner and I recently purchased a Hyundai Tucson through Dene Gregg at the dealership. Dene was absolutely lovely and thorough with the process. We had a nightmare dealing with our bank. There was a huge delay on our loan application but Dene was very helpful, understanding and patient throughout the whole process. I couldn’t fault him or the team at Brighton Auto. They have a great range of cars and I wouldn’t hesitate to recommend getting your next car from them. It was definitely worth going to this dealership all the way from Cockatoo in the Dandenong Ranges. Thanks again!!", "time" : 1623737026 } ], "types" : [ "car_dealer", "point_of_interest", "store", "establishment" ], "url" : "https://maps.google.com/?cid=10763243739560515148", "user_ratings_total" : 312, "utc_offset" : 600, "vicinity" : "67 Nepean Highway, Elsternwick", "website" : "http://www.brightonmitsubishi.com.au/" }, "status" : "OK"}