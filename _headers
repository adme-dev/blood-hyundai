# Netlify Edge Headers
# These headers complement netlify.toml and are processed at the edge

# Root HTML - Never cache to prevent SPA routing issues
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# All HTML files - Never cache
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JavaScript chunks - Short cache with revalidation for SPA
/js/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=86400, must-revalidate

# CSS files - Short cache with revalidation
/css/*
  Cache-Control: public, max-age=86400, must-revalidate
  
/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate

# Static assets - Long cache
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# API and dynamic content - No cache
/api/*
  Cache-Control: no-cache, no-store, must-revalidate

/.netlify/functions/*
  Cache-Control: no-cache, no-store, must-revalidate

# Service Worker - Critical, never cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Manifest files - Short cache
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
